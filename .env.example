# ==============================================================================
# ACTIS Environment Configuration
# 
# Copy this file to '.env' in the repo root and fill in your credentials and paths:
#   cp .env.example .env
#
# Note: '.env' is ignored by git (.gitignore) to keep your credentials secure.
# ==============================================================================

# Specify a location for the Hugging Face cache
# HF_HOME=/path/to/huggingface/cache

# Alternatively, specify only datasets cache:
# HF_DATASETS_CACHE=/path/to/huggingface/datasets/cache

# When running with Azure OpenAI models (e.g. model "azure/gpt-4o" or
# "azure/<your_deployment_name>"), LiteLLM automatically uses these settings:
AZURE_API_KEY=your_azure_api_key_here
AZURE_API_BASE=https://your-resource-name.openai.azure.com/
# AZURE_API_VERSION=2024-08-01-preview

# If using direct OpenAI API endpoints (e.g. model "gpt-4o"):
# OPENAI_API_KEY=your_openai_api_key_here
